# ==============================================================================
# SDG Delivery - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto
# ==============================================================================

# Supabase (Banco de Dados, Autenticação e Storage)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Impressora de Rede / Bridge Local (opcional)
VITE_PRINTER_IP=192.168.1.100
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100
